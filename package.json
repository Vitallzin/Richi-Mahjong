{
  "name": "riichi-mahjong-ptbr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Riichi Mahjong em português do Brasil, com guia opcional para iniciantes.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:sim": "vitest run --config vitest.sim.config.ts",
    "icons": "node scripts/gen-icons.mjs",
    "sim": "tsx scripts/simulate.ts",
    "sounds": "node scripts/gen-sounds.mjs",
    "emulators": "firebase emulators:start --only auth,database",
    "dev:emulators": "vite --port 3100 --mode emulators",
    "test:rules": "firebase emulators:exec --only database --project demo-richimahjong \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@fontsource/shippori-mincho": "^5.3.0",
    "firebase": "^13.0.0",
    "howler": "^2.2.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/howler": "^2.2.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
