# Configuração web do Firebase (pública por natureza; a proteção vem das regras do banco e da
# restrição de referenciador da chave no Google Cloud). Copie para .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=richimahjong.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=richimahjong
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# URL do Realtime Database (aparece no console depois de criar o banco em us-central1).
VITE_FIREBASE_DATABASE_URL=https://richimahjong-default-rtdb.firebaseio.com
